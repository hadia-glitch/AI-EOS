# Copy to backend/.env and fill in values.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# LLM toggle — flip one bool to switch providers:
# USE_LOCAL_LLM=true  → Ollama/vLLM first, then Gemini/Groq (unless DISABLE_CLOUD_LLM_FALLBACK=true)
# USE_LOCAL_LLM=false → Gemini → Groq only (skip local)
USE_LOCAL_LLM=true
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=mistral:7b-instruct-q4_K_M
LOCAL_LLM_TIMEOUT_SECONDS=1200
LOCAL_LLM_KEEP_ALIVE=30m
LOCAL_LLM_JSON_MODE=false
DISABLE_CLOUD_LLM_FALLBACK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# RAG ablation (defaults = production baseline)
CHUNKING_STRATEGY=fixed
ENABLE_QUERY_REFINEMENT=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

GUIDELINES_DIR=./guidelines
API_HOST=0.0.0.0
API_PORT=8000
