# Server
API_HOST=0.0.0.0
API_PORT=8000
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── LLM provider toggle ──────────────────────────────────────────────────────
# USE_LOCAL_LLM=true  → try Ollama/vLLM first (see LOCAL_LLM_* below)
# USE_LOCAL_LLM=false → skip local model, use Gemini → Groq cloud chain directly
USE_LOCAL_LLM=true

# ── Local LLM (Mistral-7B via Ollama or vLLM) ────────────────────────────────
# Add these lines to your existing backend/.env — do not replace the whole
# file, just append/merge these keys.

# Master switch. true = try the local model first (see config.py for the
# full provider order: Local -> Gemini -> Groq -> rule-based).
LOCAL_LLM_ENABLED=true

# Ollama (dev, this machine):        http://localhost:11434/v1
# vLLM (production, separate host):  http://<vllm-host>:8000/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Must match exactly what you pulled/served:
#   Ollama:  mistral:7b-instruct-q4_K_M   (tag as shown by `ollama list`)
#   vLLM:    mistralai/Mistral-7B-Instruct-v0.3  (HF repo id, or your
#            --served-model-name if you set one)
#LOCAL_LLM_MODEL=mistral:7b-instruct-q4_K_M
LOCAL_LLM_MODEL=mistral:7b-instruct-q4_K_M

# Generous on purpose — a 7B model on CPU or a shared GPU can be slow, and
# a timeout here just means "fall through to Gemini/Groq/rule-based",
# not a crash. Tune down once you've measured your real latency.
#LOCAL_LLM_TIMEOUT_SECONDS=120

# HIPAA-strict mode. When true, Gemini/Groq are NEVER attempted even if
# USE_LOCAL_LLM=true and API keys are set. Set false to allow cloud fallback
# when the local model is down or USE_LOCAL_LLM=false.
DISABLE_CLOUD_LLM_FALLBACK=false

# ── Existing cloud keys — keep or remove ─────────────────────────────────────
# Leave these set while DISABLE_CLOUD_LLM_FALLBACK=false: they become your
# safety net if the local LLM is ever down (container crashed, OOM, etc).
# Once you're confident in the local setup and flip DISABLE_CLOUD_LLM_FALLBACK
# to true, these are never called and can be deleted entirely.
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
